[
  {
    "name": "/div with two numbers returns the quotient",
    "steps": [
      {
        "send": { "text": "/div 10 2" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "10 / 2 = 5" } }
        ]
      }
    ]
  },
  {
    "name": "/div with no arguments shows usage",
    "steps": [
      {
        "send": { "text": "/div" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Usage: /div <numerator> <denominator>" } }
        ]
      }
    ]
  },
  {
    "name": "/div division by zero triggers error reply",
    "steps": [
      {
        "send": { "text": "/div 10 0" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "An internal error occurred." } }
        ]
      }
    ]
  },
  {
    "name": "/div with non-numeric input triggers error reply",
    "steps": [
      {
        "send": { "text": "/div abc def" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "An internal error occurred." } }
        ]
      }
    ]
  }
]