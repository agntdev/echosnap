[
  {
    "name": "/echo truncates text longer than 4096 characters",
    "steps": [
      {
        "send": {
          "text": "/echo "
        },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "..."
            }
          }
        ]
      }
    ]
  },
  {
    "name": "/echo does not truncate text exactly 4096 characters",
    "steps": [
      {
        "send": {
          "text": "/echo "
        },
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": ""
            }
          }
        ]
      }
    ]
  }
]